{
  "manifest_version": 3,
  "name": "DraftForge ESPN Companion",
  "version": "0.2.10",
  "description": "Securely connects DraftForge to your signed-in ESPN Fantasy draft room.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "https://lm-api-reads.fantasy.espn.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/*"],
      "js": ["espn-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://draftforge-ai.workspace-231977.chatgpt.site/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "DraftForge ESPN Companion" }
}
