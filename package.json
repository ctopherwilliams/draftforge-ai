{
  "name": "draftforge-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "precheck": "node scripts/live-code-freeze.mjs check --operation test",
    "predev": "node scripts/live-code-freeze.mjs check --operation dev",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1",
    "prebuild": "node scripts/live-code-freeze.mjs check --operation build",
    "build": "node scripts/build-production.mjs",
    "prestart": "node scripts/live-code-freeze.mjs check --operation start",
    "start": "node scripts/start-production.mjs",
    "pretest": "node scripts/live-code-freeze.mjs check --operation test",
    "test": "npm run typecheck && npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "pretest:visual": "node scripts/live-code-freeze.mjs check --operation test",
    "test:visual": "npm run build && node scripts/ui-visual-certification.mjs",
    "pretest:live-control": "node scripts/live-code-freeze.mjs check --operation test",
    "test:live-control": "node scripts/live-control-release-gate.mjs",
    "pretest:production-path": "node scripts/live-code-freeze.mjs check --operation test",
    "test:production-path": "node --expose-gc scripts/live-control-production-path.mjs",
    "pretest:load": "node scripts/live-code-freeze.mjs check --operation test",
    "test:load": "node scripts/live-control-load.mjs",
    "pretest:chaos": "node scripts/live-code-freeze.mjs check --operation test",
    "test:chaos": "node scripts/live-control-chaos.mjs",
    "pretest:soak": "node scripts/live-code-freeze.mjs check --operation test",
    "test:soak": "node scripts/live-control-soak.mjs",
    "pretest:contention": "node scripts/live-code-freeze.mjs check --operation test",
    "test:contention": "node --expose-gc scripts/live-control-contention.mjs",
    "pretypecheck": "node scripts/live-code-freeze.mjs check --operation test",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm test",
    "prelint": "node scripts/live-code-freeze.mjs check --operation test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "presimulate:monte-carlo": "node scripts/live-code-freeze.mjs check --operation test",
    "simulate:monte-carlo": "node scripts/monte-carlo.mjs",
    "presimulate:matrix": "node scripts/live-code-freeze.mjs check --operation test",
    "simulate:matrix": "node scripts/monte-carlo-matrix.mjs",
    "presnapshot:capture": "node scripts/live-code-freeze.mjs check --operation source-refresh",
    "snapshot:capture": "node scripts/capture-source-snapshot.mjs",
    "availability:stage": "node scripts/stage-availability.mjs",
    "predraft-day:warm": "node scripts/live-code-freeze.mjs check --operation source-refresh",
    "draft-day:warm": "node scripts/draft-day-warm.mjs",
    "draft-day:audit": "node scripts/draft-day-audit.mjs",
    "draft-day:ready": "node scripts/draft-day-ready.mjs",
    "draft-day:doctor": "node scripts/draft-day-doctor.mjs",
    "draft-day:status": "node scripts/draft-day-status.mjs",
    "draft-day:retire-checkpoint": "node scripts/retire-draft-audit-checkpoint.mjs",
    "draft-day:freeze": "node scripts/live-code-freeze.mjs",
    "draft-day:monitor": "node scripts/live-control-monitor.mjs",
    "preextension:package": "node scripts/live-code-freeze.mjs check --operation extension-package",
    "extension:package": "node scripts/build-extension-package.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.3",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.121.0"
  },
  "type": "module"
}
