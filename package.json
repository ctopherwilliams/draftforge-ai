{
  "name": "draftforge-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --hostname 127.0.0.1",
    "test": "npm run typecheck && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:visual": "npm run build && node scripts/ui-visual-certification.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "simulate:monte-carlo": "node scripts/monte-carlo.mjs",
    "simulate:matrix": "node scripts/monte-carlo-matrix.mjs",
    "snapshot:capture": "node scripts/capture-source-snapshot.mjs",
    "draft-day:warm": "node scripts/draft-day-warm.mjs",
    "draft-day:audit": "node scripts/draft-day-audit.mjs",
    "draft-day:ready": "node scripts/draft-day-ready.mjs",
    "draft-day:doctor": "node scripts/draft-day-doctor.mjs",
    "extension:package": "node scripts/build-extension-package.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.3",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.121.0"
  },
  "type": "module"
}
